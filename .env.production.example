# ------------------------------------------------------------------------------
# Production template – copy to .env on the server and fill in every empty value.
# Never commit the filled-in file.
#
# Works on shared web hosting (e.g. Hostinger): one MySQL database for all
# property managements, no Redis and no queue worker required.
# ------------------------------------------------------------------------------

APP_NAME=Liegenschaftsportal
APP_ENV=production
# Generate once with: php artisan key:generate  (never change it afterwards: encrypted data would be lost)
APP_KEY=
APP_DEBUG=false
APP_DEMO_MODE=false
APP_URL=https://liegenschaftsportal.ch
CENTRAL_DOMAIN=liegenschaftsportal.ch

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_CH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Daily log files, kept for 90 days (see privacy policy)
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=90
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# One database for the platform and all property managements
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# No queue worker on shared hosting: mails are sent directly. With a worker
# (Supervisor or a cron running queue:work) "database" can be used instead.
QUEUE_CONNECTION=sync

# No Redis on shared hosting; the database cache is sufficient.
CACHE_STORE=database

# Outgoing mail (invitations, password resets, notifications) – Hostinger: smtp.hostinger.com
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@liegenschaftsportal.ch
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@liegenschaftsportal.ch
MAIL_FROM_NAME="${APP_NAME}"

# Admin panel: second factor is mandatory for administrators and clerks
ADMIN_MFA_REQUIRED=true

# Bearer token for POST /api/onboard – generate with: openssl rand -hex 32
TENANT_ONBOARDING_TOKEN=

# Error monitoring (optional) – use a project in the EU region (de.sentry.io) and enable
# "Prevent Storing of IP Addresses". The privacy policy only mentions Sentry when a DSN is set.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

# Backups (php artisan backup:run, scheduled daily via the cron for schedule:run)
# Archives are encrypted with this password – store it separately, without it backups cannot be restored.
BACKUP_ARCHIVE_PASSWORD=
# Comma separated disks: "backups" = this server, "backups_offsite" = S3 object storage (recommended in addition)
BACKUP_DISKS=backups
BACKUP_NOTIFICATION_EMAIL=info@liegenschaftsportal.ch
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=

# Legal pages (Impressum / Datenschutz / AGB)
LEGAL_EMAIL=info@liegenschaftsportal.ch
LEGAL_PHONE=
# Fill in after the entry in the commercial register (CHE-xxx.xxx.xxx)
LEGAL_UID=
LEGAL_HOSTING_PROVIDER="Hostinger International Ltd."
LEGAL_HOSTING_LOCATION="Deutschland (Frankfurt am Main)"
